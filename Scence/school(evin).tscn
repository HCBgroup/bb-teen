[node name="NPC_Rohan" type="StaticBody2D" parent="."]
position = Vector2(195, 460)
collision_layer = 2
collision_mask = 0
script = ExtResource("5_1wnpj")
dialogue_lines = PackedStringArray("Psst! Arun! Look at this paper airplane I made out of formula sheets.", "Bro, relax! Nobody looks at high school grades ten years from now.", "After this period, let's hit the walkway stream and get some fresh air.", "Breathe easy, man. You stress way too much!")
npc_name = "Rohan"
sprite_texture = ExtResource("8_rohan")

