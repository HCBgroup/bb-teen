[node name="Prop_Mirror" type="Area2D" parent="."]
position = Vector2(310, 210)
script = ExtResource("7_prop")
prop_name = "Wall Mirror"
prompt_text = "[E] Look into Mirror"
modal_title = "GOLD-RIMMED BEDROOM MIRROR"
modal_content = "You stare into the glass. Tired eyes, uniform collar half-straightened.\n\nThe reflection of an Indian teen carrying the weight of a thousand expectations.\n\n'Everyone is waiting to see my marks today. But failure isn't final.\nTake a breath, Arun. Bounce Back.'\n\n[OBJECTIVE: Go to the kitchen, drink Mom's turmeric milk, and head through front door to school!]"

[node name="CollisionShape2D" type="CollisionShape2D" parent="Prop_Mirror"]
shape = SubResource("CircleShape2D_prop_zone")

[node name="Prop_AlarmClock" type="Area2D" parent="."]
position = Vector2(240, 242)
script = ExtResource("7_prop")
prop_name = "Alarm Clock"
prompt_text = "[E] Check Clock"
modal_title = "DIGITAL BEDSIDE CLOCK"
modal_content = "TIME: 07:42 AM  |  ALARM: OFF\n-----------------------------------------------\nThe alarm has been ringing for 15 minutes!\n\nThe mid-term exam at school begins at 08:30 AM!\nIf you rush through the walkway path now,\nyou will reach classroom just in time."

[node name="CollisionShape2D" type="CollisionShape2D" parent="Prop_AlarmClock"]
shape = SubResource("CircleShape2D_prop_zone")

[node name="Prop_Diary" type="Area2D" parent="."]
position = Vector2(390, 265)
script = ExtResource("7_prop")
prop_name = "Personal Diary"
prompt_text = "[E] Read Diary"
modal_title = "ARUN'S STUDY DIARY"
modal_content = "ENTRY: 'THE PRESSURE COOKER'\n===============================================\n'Everyone expects top marks. Uncle Sharma was\n bragging about his son's 99 percentile again.\n\n Mom works so hard, and Dad looks tired every night.\n I can't let them down. But my chest feels tight\n whenever I open this algebra textbook.\n\n Goal for today: Don't freeze up. Remember to breathe.\n Bounce Back when panic hits.'"

[node name="CollisionShape2D" type="CollisionShape2D" parent="Prop_Diary"]
